{
  "manifest_version": 3,
  "name": "Bingqilin Popup Blocker",
  "version": "1.1.0",
  "description": "Closes the popups and tab-unders that the Bingqilin player's video embeds open. Runs on the player only — never on the tools pages or anywhere else.",
  "minimum_chrome_version": "102",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": { "service_worker": "background.js", "type": "module" },

  "permissions": ["webNavigation", "storage"],

  "host_permissions": ["https://thebingchilling.github.io/*"],

  "content_scripts": [
    {
      "matches": ["https://thebingchilling.github.io/*"],
      "exclude_matches": ["https://thebingchilling.github.io/tools/*"],
      "js": ["content/keepalive.js"],
      "run_at": "document_start"
    }
  ]
}
